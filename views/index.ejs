<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexaPulse — Portal Berita & Informasi Terkini</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, sans-serif;
        }

        body {
            background: #0f172a;
            color: #f8fafc;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Header & Brand */
        header {
            background: rgba(30, 41, 59, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 1.4rem;
            font-weight: 800;
            color: #f8fafc;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 4px;
            text-decoration: none;
        }

        .logo span {
            color: #38bdf8;
        }

        .logo-dot {
            width: 8px;
            height: 8px;
            background: #38bdf8;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 10px #38bdf8;
        }

        nav {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            align-items: center;
        }

        nav a {
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            transition: all 0.2s;
        }

        nav a:hover,
        nav a.active {
            color: #f8fafc;
            background: rgba(56, 189, 248, 0.15);
            border: 1px solid rgba(56, 189, 248, 0.3);
        }

        /* Form Pencarian */
        .search-form {
            display: flex;
            gap: 0.5rem;
        }

        .search-input {
            background: #0f172a;
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #f8fafc;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            font-size: 0.85rem;
            outline: none;
            transition: border-color 0.2s;
        }

        .search-input:focus {
            border-color: #38bdf8;
        }

        .search-btn {
            background: #38bdf8;
            color: #0f172a;
            border: none;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            font-size: 0.85rem;
            transition: opacity 0.2s;
        }

        .search-btn:hover {
            opacity: 0.9;
        }

        .container {
            max-width: 1100px;
            margin: 2.5rem auto;
            padding: 0 1rem;
            flex: 1;
            width: 100%;
        }

        .hero-section {
            margin-bottom: 2.5rem;
            border-left: 4px solid #38bdf8;
            padding-left: 1rem;
        }

        h1 {
            color: #f8fafc;
            margin-bottom: 0.25rem;
            font-size: 1.75rem;
            font-weight: 700;
        }

        p {
            color: #94a3b8;
            font-size: 0.95rem;
        }

        /* Grid Kartu Berita */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 1.5rem;
        }

        .card {
            background: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s, border-color 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: rgba(56, 189, 248, 0.4);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .card-img {
            width: 100%;
            height: 170px;
            object-fit: cover;
            border-bottom: 1px solid rgba(255, 255, 258, 0.08);
        }

        .card-body {
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            justify-content: space-between;
        }

        .card h3 {
            font-size: 1.05rem;
            margin-bottom: 1rem;
            line-height: 1.4;
        }

        .card h3 a {
            color: #f8fafc;
            text-decoration: none;
            transition: color 0.2s;
        }

        .card h3 a:hover {
            color: #38bdf8;
        }

        .meta {
            font-size: 0.8rem;
            color: #94a3b8;
            margin-top: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .badge {
            background: rgba(56, 189, 248, 0.1);
            color: #38bdf8;
            padding: 0.25rem 0.65rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 0.75rem;
            border: 1px solid rgba(56, 189, 248, 0.2);
        }

        .not-found {
            grid-column: 1 / -1;
            text-align: center;
            color: #94a3b8;
            padding: 3rem 0;
            font-size: 1.1rem;
        }

        /* Pagination Rapi */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 0.4rem;
            margin-top: 3.5rem;
            flex-wrap: wrap;
        }

        .pagination a,
        .pagination span {
            background: #1e293b;
            color: #f8fafc;
            padding: 0.5rem 0.9rem;
            border-radius: 8px;
            text-decoration: none;
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 0.9rem;
            font-weight: 500;
            transition: background 0.2s;
        }

        .pagination a:hover {
            background: #38bdf8;
            color: #0f172a;
        }

        .pagination .active {
            background: #38bdf8;
            color: #0f172a;
            font-weight: bold;
            border-color: #38bdf8;
        }

        .pagination .dots {
            background: transparent;
            border: none;
            color: #94a3b8;
        }

        /* Footer Profesional */
        footer {
            background: #1e293b;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            text-align: center;
            padding: 1.5rem;
            color: #94a3b8;
            font-size: 0.85rem;
            margin-top: 4rem;
        }

        footer span {
            color: #38bdf8;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <!-- Header Brand & Search -->
    <header>
        <a href="/" class="logo">
            Nexa<span>Pulse</span><span class="logo-dot"></span>
        </a>
        <nav>
            <% Object.keys(categories).forEach(key=> { %>
                <a href="/?category=<%= key %>"
                    class="<%= currentCategoryKey === key && !searchQuery ? 'active' : '' %>">
                    <%= categories[key].name %>
                </a>
                <% }) %>

                    <!-- Kolom Search -->
                    <form action="/" method="GET" class="search-form">
                        <input type="hidden" name="category" value="<%= currentCategoryKey %>">
                        <input type="text" name="q" placeholder="Cari berita..." value="<%= searchQuery %>"
                            class="search-input">
                        <button type="submit" class="search-btn">Cari</button>
                    </form>
        </nav>
    </header>

    <div class="container">
        <div class="hero-section">
            <h1>Eksplorasi Berita Terkini</h1>
            <p>
                <% if (searchQuery) { %>
                    Hasil pencarian untuk: "<strong>
                        <%= searchQuery %>
                    </strong>"
                    <% } else { %>
                        Kurasi informasi real-time dan terpercaya dari berbagai lini media digital.
                        <% } %>
            </p>
        </div>

        <div class="grid">
            <% if (articles.length> 0) { %>
                <% articles.forEach(article=> { %>
                    <div class="card">
                        <img src="<%= article.imageUrl %>" alt="Thumbnail" class="card-img" loading="lazy">
                        <div class="card-body">
                            <div>
                                <span class="badge">
                                    <%= article.sourceName %>
                                </span>
                                <h3><a href="<%= article.link %>" target="_blank">
                                        <%= article.title %>
                                    </a></h3>
                            </div>
                            <div class="meta">
                                <span>🕒 <%= article.pubDate %></span>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="not-found">Berita yang kamu cari tidak ditemukan. Coba kata kunci lain!</div>
                            <% } %>
        </div>

        <!-- Pagination -->
        <% if (totalPages> 1) { %>
            <div class="pagination">
                <% let maxVisiblePages=5; let startPage=Math.max(1, currentPage - Math.floor(maxVisiblePages / 2)); let
                    endPage=Math.min(totalPages, startPage + maxVisiblePages - 1); if (endPage - startPage + 1 <
                    maxVisiblePages) { startPage=Math.max(1, endPage - maxVisiblePages + 1); } %>

                    <% if (currentPage> 1) { %>
                        <a href="/?category=<%= currentCategoryKey %>&q=<%= searchQuery %>&page=<%= currentPage - 1 %>">&laquo;
                            Prev</a>
                        <% } %>

                            <% if (startPage> 1) { %>
                                <a href="/?category=<%= currentCategoryKey %>&q=<%= searchQuery %>&page=1">1</a>
                                <% if (startPage> 2) { %> <span class="dots">...</span>
                                    <% } %>
                                        <% } %>

                                            <% for(let i=startPage; i <=endPage; i++) { %>
                                                <% if(i===currentPage) { %>
                                                    <span class="active">
                                                        <%= i %>
                                                    </span>
                                                    <% } else { %>
                                                        <a
                                                            href="/?category=<%= currentCategoryKey %>&q=<%= searchQuery %>&page=<%= i %>">
                                                            <%= i %>
                                                        </a>
                                                        <% } %>
                                                            <% } %>

                                                                <% if (endPage < totalPages) { %>
                                                                    <% if (endPage < totalPages - 1) { %> <span
                                                                            class="dots">...</span>
                                                                        <% } %>
                                                                            <a
                                                                                href="/?category=<%= currentCategoryKey %>&q=<%= searchQuery %>&page=<%= totalPages %>">
                                                                                <%= totalPages %>
                                                                            </a>
                                                                            <% } %>

                                                                                <% if (currentPage < totalPages) { %>
                                                                                    <a
                                                                                        href="/?category=<%= currentCategoryKey %>&q=<%= searchQuery %>&page=<%= currentPage + 1 %>">Next
                                                                                        &raquo;</a>
                                                                                    <% } %>
            </div>
            <% } %>
    </div>

    <!-- Footer Profesional -->
    <footer>
        <p>&copy; 2026 <span>NexaPulse</span>. All rights reserved. Automated News Intelligence System.</p>
    </footer>

</body>

</html>